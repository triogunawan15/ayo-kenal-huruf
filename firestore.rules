rules_version = '2';

// ---------------------------------------------------------------
// Cara pasang: buka Firebase Console -> Firestore Database -> tab "Rules"
// -> paste isi file ini -> Publish.
//
// Prinsipnya: tiap user (termasuk yang anonim) HANYA boleh baca/tulis
// dokumen di bawah path miliknya sendiri (users/{uid}), tidak bisa
// mengintip atau mengubah data anak lain. Ini penting karena data yang
// disimpan menyangkut progres belajar anak.
// ---------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /sessionLog/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
